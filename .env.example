# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.

# Supabase, Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Postgres password. A real secret. Used by scripts/ only, never by the app.
SUPABASE_DB_PASSWORD=
